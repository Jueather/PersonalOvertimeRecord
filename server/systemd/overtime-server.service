[Unit]
Description=Overtime Record Team Server (Ktor + SQLite)
After=network.target

[Service]
Type=simple
User=overtime
Group=overtime
WorkingDirectory=/var/lib/overtime-server
ExecStart=/usr/bin/java -Xms64m -Xmx256m -jar /opt/overtime-server/overtime-server-all.jar -config=/etc/overtime-server/application.conf
Restart=always
RestartSec=5

# 环境变量（可选）：首启指定管理员初始密码，避免去日志里找随机密码
#Environment=ADMIN_INITIAL_PASSWORD=change-me-please

# ---- 安全加固 ----
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/overtime-server

[Install]
WantedBy=multi-user.target
