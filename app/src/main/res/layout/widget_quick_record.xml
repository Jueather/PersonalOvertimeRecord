<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件布局：仅使用 RemoteViews 支持的控件（LinearLayout / TextView） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_month_placeholder"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetHours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0.0h"
            android:textColor="@color/widget_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWidgetPay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_net_salary"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnWidgetOvertime"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_quick_overtime"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnWidgetExtra"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_quick_extra"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnWidgetOpen"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_outline_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_submit"
            android:textColor="@color/widget_accent"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
