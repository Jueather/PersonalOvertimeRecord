<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    
    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 自动同步已迁移至 WorkManager：不再需要 RECEIVE_BOOT_COMPLETED、
         SCHEDULE_EXACT_ALARM（WorkManager 会在其自身合并清单中声明所需权限） -->
    
    <!-- 软件自动更新：Android 8.0+ 安装未知来源 APK 需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 系统日历双向同步：读取/写入日程（运行时申请） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 测试用：获取完整已安装应用列表（上架前必须移除，Google Play 对此权限有审核要求） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".OvertimeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalOvertimeRecord"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.PersonalOvertimeRecord">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.PersonalOvertimeRecord" />
        <activity
            android:name=".BiometricActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReportActivity"
            android:exported="false" />
        <activity
            android:name=".DataManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ChangeLogActivity"
            android:exported="false" />
        <activity
            android:name=".RelaxActivity"
            android:exported="false" />
        <activity
            android:name=".BreathGuideActivity"
            android:exported="false" />
        <activity
            android:name=".BubblePopActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.TeamSummaryActivity"
            android:exported="false" />
            
        <!-- 桌面小部件：展示当月工时/实发并支持快捷登记 -->
        <receiver
            android:name=".widget.QuickRecordWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_record_widget_info" />
        </receiver>
        <!-- 小部件/常驻通知的快捷登记广播（仅应用内发送） -->
        <receiver
            android:name=".widget.QuickEntryReceiver"
            android:exported="false" />

        <!-- FileProvider for sharing files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
